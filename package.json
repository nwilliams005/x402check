{
  "name": "x402check",
  "version": "0.1.0",
  "private": true,
  "description": "x402check \u2014 paid per-tool trust check before an agent pays an x402 endpoint",
  "type": "module",
  "scripts": {
    "dev": "WRANGLER_CACHE_DIR=/tmp/wcache wrangler dev --config wrangler.dev.toml --local --port 8787 --ip 127.0.0.1",
    "test:local": "WRANGLER_CACHE_DIR=/tmp/wcache node scripts/test-local.mjs",
    "typecheck": "tsc --noEmit",
    "deploy:dry": "echo 'See DEPLOY.md \u2014 do not deploy without Nicklaus approval'",
    "test:payconfig": "node scripts/test-payconfig.mjs",
    "test:mcp-payment": "npx --yes tsx scripts/test-mcp-payment.mjs"
  },
  "dependencies": {
    "@coinbase/cdp-sdk": "^1.60.0",
    "@solana/kit": "^8.6.0",
    "@x402/core": "^2.29.0",
    "@x402/evm": "^2.29.0",
    "@x402/extensions": "^2.29.0",
    "@x402/hono": "^2.29.0",
    "@x402/svm": "^2.29.0",
    "hono": "^4.13.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260503.1",
    "typescript": "^5.9.3",
    "wrangler": "^4.86.0"
  }
}
